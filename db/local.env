# Local database (docker compose). No secrets: used by npm run dev, db:reset and e2e.
NEON_DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
# Empty: magic links are printed to the dev server output instead of emailed.
EMAIL_SERVER_USER=
# Empty: Amazon previews fall back to URL parsing instead of spending the paid RapidAPI quota.
RAPID_API_KEY=
NEXTAUTH_URL=http://localhost:3000
