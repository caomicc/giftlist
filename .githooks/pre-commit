#!/bin/sh
# Blocks the commit if lint or unit tests fail. Skip once with: git commit --no-verify
set -e
echo "pre-commit: npm run lint"
npm run lint --silent
echo "pre-commit: npm test"
npm test --silent > /tmp/giftlist-pre-commit-tests.log 2>&1 || { cat /tmp/giftlist-pre-commit-tests.log; echo "pre-commit: unit tests failed"; exit 1; }
